{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/index\\.php$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/baca\\.php$",
      "dest": "/api/baca.php"
    },
    {
      "handle": "filesystem"
    }
  ]
}